{
  "name": "ragequiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types --include-env=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "npm run test:unit && npm run test:worker && npm run test:do",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:do": "vitest run --config vitest.do.config.ts --max-workers=1 --no-isolate",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke-local.ts",
    "e2e:server": "wrangler d1 migrations apply DB --local && vite build && vite preview",
    "bank": "tsx scripts/quiz-bank.ts",
    "lint:copy": "tsx scripts/lint-copy.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vitest": "4.1.12"
  }
}
